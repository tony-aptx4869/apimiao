[Unit]
Description=APIMiao - API relay platform
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__APP_DIR__
# 所有配置集中在 __APP_DIR__/config.ini（复制自 config.ini.example）
ExecStart=__APP_DIR__/.venv/bin/gunicorn -c __APP_DIR__/gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
